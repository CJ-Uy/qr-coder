	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/qrcode": "1.5.6",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"@types/styled-jsx": "^3.4.4",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"jsqr": "1.4.0",
